# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.1'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Awsome' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Force deployment target on every pod target + aggregate target.
    # Some pods (AsyncStorage, netinfo, safe-area-context) inherit their
    # IPHONEOS_DEPLOYMENT_TARGET from xcconfig files, which makes the
    # build_settings hash return nil/0 — so a conditional check is not enough.
    # Setting it unconditionally overwrites both direct and inherited values.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
      end
    end
    # Also patch the generated aggregate targets (e.g. Pods-Awsome)
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.xcconfigs.each do |config_name, config_file|
        config_file.attributes['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        xcconfig_path = aggregate_target.xcconfig_path(config_name)
        config_file.save_as(Pathname.new(xcconfig_path))
      end
    end
  end
end
